config PHY_ZHIHE_SNPS_USB2
	tristate "ZhiHe Synopsys USB 2.0 PHY driver"
	depends on (ARCH_ZHIHE && OF) || COMPILE_TEST
	depends on HAS_IOMEM
	select GENERIC_PHY
	default USB_DWC3 if ARCH_ZHIHE
	help
	  Enable this to support the Synopsys USB 2.0 PHY instances in
	  ZhiHe A210 SoCs, including the PHY shared with the DWC3 controller.

	  To compile this driver as a module, choose M here: the module
	  will be called phy-zhihe-snps-usb2.
